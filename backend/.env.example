# Development template only. Copy to .env and replace every CHANGE_ME value.
# Never use these placeholders or this SQLite configuration in production.
APP_NAME=LegacyGuard
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./legacyguard.db
SECRET_KEY=CHANGE_ME_development_secret_at_least_24_chars_123
# Generate a development key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_valid_Fernet_key
JWT_SECRET=CHANGE_ME_development_jwt_secret_at_least_24_chars_123
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional local override:
# DOCUMENT_STORAGE_ROOT=./private_storage/documents

# Production requirements (documentation only; do not uncomment as-is):
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://APP_USER:PERCENT_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
# SECRET_KEY=<unique secret from an approved production secret manager>
# ENCRYPTION_KEY=<valid Fernet key from an approved production secret manager or KMS-backed configuration>
# JWT_SECRET=<different unique secret from an approved production secret manager>
# CORS_ALLOWED_ORIGINS=https://YOUR_APPROVED_FRONTEND_ORIGIN
# DOCUMENT_STORAGE_ROOT=<persistent encrypted storage path>
