# Development template only. Copy to .env and replace every CHANGE_ME value.
# Operating-system/process environment variables take precedence over this file.
# On PowerShell, inspect inherited values with Get-ChildItem Env: and remove only
# a conflicting value from the current process, for example:
# Remove-Item Env:DEBUG -ErrorAction SilentlyContinue
# Never use these placeholders or this SQLite configuration in production.
APP_NAME=LegacyGuard
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./legacyguard.db
SECRET_KEY=CHANGE_ME_development_secret_at_least_24_chars_123
# Generate a development key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_valid_Fernet_key
JWT_SECRET=CHANGE_ME_development_jwt_secret_at_least_24_chars_123
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional local override:
# DOCUMENT_STORAGE_ROOT=./private_storage/documents
# DOCUMENT_STORAGE_BACKEND=LOCAL
# DOCUMENT_MASTER_KEY_ID=legacy-current-v1

# S3-compatible object-storage example (synthetic values only):
# DOCUMENT_STORAGE_BACKEND=OBJECT
# DOCUMENT_OBJECT_BUCKET=legacyguard-synthetic-documents
# DOCUMENT_OBJECT_PREFIX=legacyguard
# DOCUMENT_OBJECT_REGION=us-east-1
# DOCUMENT_OBJECT_ENDPOINT_URL=https://s3.example.invalid
# DOCUMENT_OBJECT_ADDRESSING_STYLE=auto
# DOCUMENT_OBJECT_CONNECT_TIMEOUT_SECONDS=5
# DOCUMENT_OBJECT_READ_TIMEOUT_SECONDS=30
# DOCUMENT_OBJECT_MAX_ATTEMPTS=3
# Prefer the provider SDK's standard credential chain (workload identity, instance
# role, or process environment). For local synthetic testing only, these optional
# explicit settings must be supplied as a pair; never commit real credentials:
# DOCUMENT_OBJECT_ACCESS_KEY_ID=CHANGE_ME_synthetic_access_key
# DOCUMENT_OBJECT_SECRET_ACCESS_KEY=CHANGE_ME_synthetic_secret_key
# DOCUMENT_OBJECT_SESSION_TOKEN=CHANGE_ME_synthetic_optional_session_token

# Production requirements (runtime-enforced; do not uncomment as-is):
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://APP_USER:PERCENT_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
# SECRET_KEY=<unique secret from an approved production secret manager>
# ENCRYPTION_KEY=<valid Fernet key from an approved production secret manager or KMS-backed configuration>
# JWT_SECRET=<different unique secret from an approved production secret manager>
# CORS_ALLOWED_ORIGINS=https://YOUR_APPROVED_FRONTEND_ORIGIN
# DOCUMENT_STORAGE_BACKEND=OBJECT
# DOCUMENT_OBJECT_BUCKET=<private production bucket name>
# DOCUMENT_OBJECT_PREFIX=legacyguard
# DOCUMENT_OBJECT_REGION=<provider region when required>
# DOCUMENT_OBJECT_ENDPOINT_URL=https://<approved S3-compatible endpoint when required>
